# Copy to .env.local (development) or .env.production.local (for `npm run db:setup:prod`),
# and set the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Public URL of the app (used for OAuth metadata); on Vercel set to https://aioapp.eu
APP_URL=https://aioapp.eu

# Claude API key for AI features (console.anthropic.com) – optional, AI is disabled without it
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Set to "false" after you created your account
ALLOW_REGISTRATION=true

# Random secret; Vercel Cron sends it as Bearer token to /api/cron/daily
CRON_SECRET=

# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
